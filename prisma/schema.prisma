generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  EDITOR
  SALES
}
enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_SENT
  CONVERTED
  CLOSED
  SPAM
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(EDITOR)
  active Boolean @default(true)
  sessions Session[]
  notes LeadNote[]
  audits AuditLog[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model SiteSettings {
  id String @id @default("global")
  data Json
  updatedAt DateTime @updatedAt
}
model NavigationItem {
  id String @id @default(cuid())
  label String
  href String
  location String @default("header")
  parentId String?
  position Int @default(0)
}
model Page {
  id String @id @default(cuid())
  slug String @unique
  title String
  status Status @default(DRAFT)
  sections Section[]
  seoTitle String?
  seoDescription String?
  updatedAt DateTime @updatedAt
}
model Section {
  id String @id @default(cuid())
  pageId String
  page Page @relation(fields:[pageId], references:[id], onDelete:Cascade)
  kind String
  position Int @default(0)
  draft Json
  published Json?
}
model MediaAsset {
  id String @id @default(cuid())
  url String @unique
  storageKey String?
  alt String
  mime String @default("image/webp")
  width Int?
  height Int?
  images ProductImage[]
  packageImages PackageImage[]
  categories Category[]
  createdAt DateTime @default(now())
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  imageId String?
  image MediaAsset? @relation(fields:[imageId],references:[id],onDelete:SetNull)
  status Status @default(DRAFT)
  position Int @default(0)
  products Product[]
}
model Collection {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  status Status @default(DRAFT)
  position Int @default(0)
  products ProductCollection[]
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  sku String @unique
  productType String @default("individual")
  variants String[] @default([])
  customisationOptions String[] @default([])
  enquiryEnabled Boolean @default(true)
  includedProducts Json @default("[]")
  packagingDetails String @default("")
  description String
  shortDescription String @default("")
  categoryId String?
  category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  tags String[]
  colors String[]
  materials String[]
  branding String[]
  packaging String[]
  dimensions String @default("")
  minimumOrder Int?
  price Decimal? @db.Decimal(12,2)
  showPrice Boolean @default(false)
  featured Boolean @default(false)
  position Int @default(0)
  status Status @default(DRAFT)
  seoTitle String?
  seoDescription String?
  images ProductImage[]
  attributes ProductAttribute[]
  collections ProductCollection[]
  packageItems PackageItem[]
  enquiryItems EnquiryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,position])
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  mediaId String
  media MediaAsset @relation(fields:[mediaId], references:[id], onDelete:Restrict)
  position Int @default(0)
}
model ProductAttribute {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  label String
  value String
}
model ProductCollection {
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  collectionId String
  collection Collection @relation(fields:[collectionId], references:[id], onDelete:Cascade)
  position Int @default(0)
  @@id([productId,collectionId])
}
model GiftPackage {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  specifications String @default("")
  status Status @default(DRAFT)
  featured Boolean @default(false)
  position Int @default(0)
  price Decimal? @db.Decimal(12,2)
  showPrice Boolean @default(false)
  seoTitle String?
  seoDescription String?
  images PackageImage[]
  items PackageItem[]
  enquiryItems EnquiryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PackageImage {
  id String @id @default(cuid())
  packageId String
  package GiftPackage @relation(fields:[packageId], references:[id], onDelete:Cascade)
  mediaId String
  media MediaAsset @relation(fields:[mediaId],references:[id],onDelete:Restrict)
  position Int @default(0)
}
model PackageItem {
  id String @id @default(cuid())
  packageId String
  package GiftPackage @relation(fields:[packageId], references:[id], onDelete:Cascade)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  quantity Int @default(1)
  @@unique([packageId,productId])
}
model Enquiry {
  id String @id @default(cuid())
  requestId String @unique
  name String
  company String
  email String
  phone String
  quantity Int
  city String?
  budget String?
  occasion String?
  message String?
  source String
  utm Json
  consentAt DateTime
  status LeadStatus @default(NEW)
  items EnquiryItem[]
  notes LeadNote[]
  notification Notification?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
}
model EnquiryItem {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields:[enquiryId],references:[id],onDelete:Cascade)
  productId String?
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
  packageId String?
  package GiftPackage? @relation(fields:[packageId],references:[id],onDelete:SetNull)
  nameSnapshot String
  skuSnapshot String?
}
model LeadNote {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields:[enquiryId],references:[id],onDelete:Cascade)
  userId String
  user AdminUser @relation(fields:[userId],references:[id])
  text String
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  enquiryId String @unique
  enquiry Enquiry @relation(fields:[enquiryId],references:[id],onDelete:Cascade)
  sentAt DateTime?
  attempts Int @default(0)
  lastError String?
}
model AuditLog {
  id String @id @default(cuid())
  userId String
  user AdminUser @relation(fields:[userId],references:[id])
  action String
  entity String
  entityId String
  createdAt DateTime @default(now())
}
model Redirect {
  from String @id
  to String
}
model Testimonial {
  id String @id @default(cuid())
  name String
  company String
  quote String
  verified Boolean @default(false)
  status Status @default(DRAFT)
  position Int @default(0)
}
model FAQ {
  id String @id @default(cuid())
  question String
  answer String
  status Status @default(DRAFT)
  position Int @default(0)
}
model Portfolio {
  id String @id @default(cuid())
  title String
  description String
  imageUrl String
  verified Boolean @default(false)
  status Status @default(DRAFT)
  position Int @default(0)
}
